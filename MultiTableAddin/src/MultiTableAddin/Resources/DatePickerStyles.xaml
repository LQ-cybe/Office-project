<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    日期选择器（MultiTableDatePicker）弹出日历的“选中日期”样式。
    浅蓝色高亮背景（#B3E5FC），与软件主色调保持一致。

    关键点：必须作为“显式 ControlTemplate”由 MultiTableDatePicker 通过
    Calendar.CalendarDayButtonStyle 直接应用；不能写成隐式 Style（优先级过低，
    默认 Calendar 模板的选中态不会响应隐式 Background 设置，这正是上版“颜色没变”的根因）。
  -->

  <Style x:Key="MultiTableCalendarDayButtonStyle" TargetType="{x:Type CalendarDayButton}">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CalendarDayButton}">
          <Grid>
            <!-- 选中态：浅蓝填充 -->
            <Border x:Name="SelectedBackground"
                    Background="#B3E5FC"
                    Opacity="0"
                    CornerRadius="4" />
            <!-- 今日：更浅的蓝底 -->
            <Border x:Name="TodayBackground"
                    Background="#E3F2FD"
                    Opacity="0"
                    CornerRadius="4" />
            <ContentPresenter x:Name="NormalText"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectedBackground" Property="Opacity" Value="1" />
              <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="#1565C0" />
              <Setter TargetName="NormalText" Property="TextElement.FontWeight" Value="Bold" />
            </Trigger>
            <Trigger Property="IsToday" Value="True">
              <Setter TargetName="TodayBackground" Property="Opacity" Value="1" />
              <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="#1565C0" />
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
              <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="#BFC4CC" />
            </Trigger>
            <Trigger Property="IsBlackedOut" Value="True">
              <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="#FFA8A8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
