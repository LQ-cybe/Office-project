<UserControl x:Class="MultiTableAddin.TaskPane.WebTaskPaneWpfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             mc:Ignorable="d">
    <Grid Margin="10" Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <hc:Card Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Margin="0,0,12,0">
                        <TextBlock Text="网页工作台" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="这个 CTP 先由 WPF 做布局分区，再在内容区内嵌 WebView2；AI 后续可以继续在上方叠加筛选器、表单、状态卡片等自定义控件。"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <hc:Tag Margin="0,0,6,0" Content="WPF 布局" />
                        <hc:Tag Margin="0,0,6,0" Content="WebView2 内嵌" />
                        <hc:Tag Content="A1 百度搜索" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="AddressTextBox"
                             MinHeight="34"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center"
                             hc:InfoElement.Placeholder="输入网址后回车，或点击右侧按钮执行导航" />

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button MinWidth="72"
                                Height="34"
                                Margin="0,0,6,0"
                                Style="{StaticResource ButtonPrimary}"
                                hc:BorderElement.CornerRadius="8"
                                Content="打开"
                                Click="OnGoClick" />
                        <Button MinWidth="72"
                                Height="34"
                                Margin="0,0,6,0"
                                Style="{StaticResource ButtonInfo}"
                                hc:BorderElement.CornerRadius="8"
                                Content="首页"
                                Click="OnHomeClick" />
                        <Button MinWidth="72"
                                Height="34"
                                Margin="0,0,6,0"
                                Style="{StaticResource ButtonInfo}"
                                hc:BorderElement.CornerRadius="8"
                                Content="刷新"
                                Click="OnRefreshClick" />
                        <Button MinWidth="84"
                                Height="34"
                                Margin="0,0,6,0"
                                Style="{StaticResource ButtonSuccess}"
                                hc:BorderElement.CornerRadius="8"
                                Content="搜索 A1"
                                Click="OnSearchA1Click" />
                        <Button MinWidth="84"
                                Height="34"
                                Style="{StaticResource ButtonPrimary}"
                                hc:BorderElement.CornerRadius="8"
                                Content="打开目录"
                                Click="OnOpenDataDirectoryClick" />
                    </WrapPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="StatusTextBlock"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Text="状态：准备初始化 WebView2" />
                        <TextBlock x:Name="DataFolderTextBlock"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="10,6"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="当前单元格预览" FontWeight="SemiBold" />
                            <TextBlock x:Name="CellPreviewTextBlock"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="A1：尚未读取"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </hc:Card>

        <hc:Card Grid.Row="1" Padding="0">
            <Grid>
                <wfi:WindowsFormsHost x:Name="WebViewHost" />

                <Border x:Name="ErrorBorder"
                        Visibility="Collapsed"
                        Background="{DynamicResource LightDangerBrush}"
                        Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ErrorTextBlock"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </hc:Card>
    </Grid>
</UserControl>
