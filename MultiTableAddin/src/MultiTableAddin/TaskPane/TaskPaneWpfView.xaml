<UserControl x:Class="MultiTableAddin.TaskPane.TaskPaneWpfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d">
    <Grid Margin="12" Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <hc:Card Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="MultiTableAddin 工作台" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0"
                           Text="这个窗格已经显式接入 HandyControl 主题与样式，可直接继续扩展为业务侧边栏。"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="保留 WPF CTP 作为主业务窗格，同时可从 Ribbon 打开独立的 WebView2 网页窗格。"
                           TextWrapping="Wrap" />
            </StackPanel>
        </hc:Card>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <hc:Card Grid.Column="0" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="快速操作" FontWeight="SemiBold" FontSize="15" />
                    <TextBox x:Name="InputTextBox"
                             Margin="0,8,0,8"
                             MinHeight="36"
                             hc:InfoElement.Placeholder="请输入内容，点击按钮后可复制反馈" />
                    <TextBlock Margin="0,0,0,8"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="这里默认放一个文本输入区，方便后续扩展查询、参数录入、批处理入口等业务操作。"
                               TextWrapping="Wrap" />
                    <TextBlock Text="内置主题色试验" FontWeight="SemiBold" FontSize="15" />
                    <ComboBox x:Name="AccentPresetComboBox"
                              Margin="0,8,0,8"
                              MinHeight="34"
                              SelectionChanged="OnAccentPresetSelectionChanged" />
                    <TextBlock x:Name="AccentPresetHintTextBlock"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="这里演示 HandyControl 内置 Accent 预设，下拉后可直接观察当前窗格主题变化。"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusTextBlock"
                               Foreground="{DynamicResource PrimaryBrush}"
                               Text="状态：就绪"
                               TextWrapping="Wrap" />
                </StackPanel>
            </hc:Card>

            <hc:Card Grid.Column="1" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="内置示例函数" FontWeight="SemiBold" FontSize="15" />
                    <hc:Tag Margin="0,8,0,4" Content="MULTITABLEADDIN_HELLO(name)" />
                    <hc:Tag Margin="0,0,0,4" Content="MULTITABLEADDIN_OPTIONAL([name], [createdAt])" />
                    <hc:Tag Margin="0,0,0,4" Content="MULTITABLEADDIN_PARAMS_SUM(values...)" />
                    <hc:Tag Margin="0,0,0,4" Content="MULTITABLEADDIN_TABLE(rows, cols)" />
                    <hc:Tag Margin="0,0,0,4" Content="MULTITABLEADDIN_LIVE_CLOCK() / LIVE_WAVE(...)" />
                    <hc:Tag Margin="0,0,0,4" Content="MULTITABLEADDIN_HANDLE_*" />
                    <hc:Tag Margin="0,0,0,4" Content="Accent 预设下拉示例" />
                    <WrapPanel Margin="0,10,0,0">
                        <Border Margin="0,0,8,0" Padding="8,4" Background="{DynamicResource PrimaryBrush}" CornerRadius="8">
                            <TextBlock Foreground="{DynamicResource TextIconBrush}" Text="Primary" />
                        </Border>
                        <Border Margin="0,0,8,0" Padding="8,4" Background="{DynamicResource WarningBrush}" CornerRadius="8">
                            <TextBlock Foreground="{DynamicResource TextIconBrush}" Text="Warning" />
                        </Border>
                        <Border Padding="8,4" Background="{DynamicResource DangerBrush}" CornerRadius="8">
                            <TextBlock Foreground="{DynamicResource TextIconBrush}" Text="Danger" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="这些函数同时演示了 IntelliSense、可选参数、params、RTD、动态数组和对象句柄，也示范了 Primary / Warning / Danger 主题色的统一使用方式。"
                               TextWrapping="Wrap" />
                    <Separator Margin="0,12,0,12" />
                    <TextBlock Text="窗口绑定状态" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Margin="0,8,0,0" Text="活动窗口键" FontWeight="SemiBold" />
                    <TextBlock x:Name="TaskPaneWindowKeyTextBlock"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Text="活动窗口标题" FontWeight="SemiBold" />
                    <TextBlock x:Name="TaskPaneWindowCaptionTextBlock"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Text="管理状态" FontWeight="SemiBold" />
                    <TextBlock x:Name="TaskPaneManagerStateTextBlock"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="这里会展示当前任务窗格与活动窗口的绑定关系。Excel 2013+ 需要按活动窗口管理；WPS 个人版通常是单 Application 共用同一任务窗格。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </hc:Card>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Style="{StaticResource ButtonPrimary}"
                    hc:BorderElement.CornerRadius="8"
                    Content="复制内容"
                    Click="OnCopyClick" />
            <Button Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Style="{StaticResource ButtonSuccess}"
                    hc:BorderElement.CornerRadius="8"
                    Content="弹出窗体"
                    Click="OnOpenDialogClick" />
            <Button Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Style="{StaticResource ButtonWarning}"
                    hc:BorderElement.CornerRadius="8"
                    Content="刷新窗格"
                    Click="OnRefreshTaskPaneStatusClick" />
            <Button Width="100"
                    Height="34"
                    Style="{StaticResource ButtonInfo}"
                    hc:BorderElement.CornerRadius="8"
                    Content="打开日志"
                    Click="OnOpenLogClick" />
        </StackPanel>
    </Grid>
</UserControl>
