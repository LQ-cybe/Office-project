<UserControl x:Class="MultiTableAddin.Views.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:charts="clr-namespace:MultiTableAddin.Views.Charts"
             xmlns:controls="clr-namespace:MultiTableAddin.Views.Controls"
             Background="{DynamicResource BackgroundBrush}"
             Loaded="ChartView_Loaded">
    <UserControl.Resources>
        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- 顶部快捷筛选 -->
        <Border DockPanel.Dock="Top" Padding="12,8"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="BtnTogglePanel" Content="隐藏配置" FontSize="12" Margin="0,0,8,0"
                            Style="{StaticResource ButtonDefault}"
                            hc:BorderElement.CornerRadius="4" Click="OnTogglePanelClick" />
                    <Button x:Name="BtnReset" Content="重置筛选" FontSize="12"
                            Style="{StaticResource ButtonDefault}"
                            hc:BorderElement.CornerRadius="4" Click="OnResetClick" />
                </StackPanel>

                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="时间粒度" Style="{StaticResource ToolLabel}" />
                    <ComboBox x:Name="QuickTimeCombo" FontSize="12" MinWidth="104" Margin="0,0,12,0"
                              VerticalAlignment="Center" SelectionChanged="OnQuickChanged" />

                    <TextBlock Text="起止" Style="{StaticResource ToolLabel}" />
                    <controls:MultiTableDatePicker x:Name="StartPicker" FontSize="12" Width="118" Margin="0,0,4,0"
                                VerticalAlignment="Center" SelectedDateChanged="OnQuickChanged" />
                    <TextBlock Text="~" Style="{StaticResource ToolLabel}" />
                    <controls:MultiTableDatePicker x:Name="EndPicker" FontSize="12" Width="118" Margin="0,0,12,0"
                                VerticalAlignment="Center" SelectedDateChanged="OnQuickChanged" />

                    <TextBlock Text="搜索" Style="{StaticResource ToolLabel}" />
                    <TextBox x:Name="SearchBox" FontSize="12" Width="150" Margin="0,0,12,0"
                             VerticalAlignment="Center"
                             hc:InfoElement.Placeholder="全字段关键字"
                             TextChanged="OnSearchChanged" />

                    <TextBlock x:Name="RowSummary" Text="" Style="{StaticResource ToolLabel}"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition x:Name="PanelColumn" Width="272" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" Padding="14"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ChartTitle" Text="图表"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock DockPanel.Dock="Top" x:Name="ChartSubtitle" Text=""
                               FontSize="11" Margin="0,4,0,10"
                               Foreground="{DynamicResource ThirdlyTextBrush}" />
                    <TextBlock DockPanel.Dock="Bottom" x:Name="ChartMessage" Text=""
                               FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningBrush}" />
                    <charts:SimpleChart x:Name="Chart" />
                </DockPanel>
            </Border>

            <Border x:Name="PanelBorder" Grid.Column="2" CornerRadius="8" Padding="14"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="图表配置" FontSize="13" FontWeight="Bold"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <ContentControl x:Name="EditorHost" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
