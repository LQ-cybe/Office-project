<UserControl x:Class="MultiTableAddin.Views.FormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource BackgroundBrush}">
    <DockPanel>
        <!-- 底部导航 -->
        <Border DockPanel.Dock="Bottom" Padding="12,8" Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="RecordInfo" Text="0 / 0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="BtnPrev" Content="上一条" Margin="0,0,8,0"
                            Style="{StaticResource ButtonDefault}" Click="OnPrevClick" />
                    <Button x:Name="BtnNext" Content="下一条" Margin="0,0,8,0"
                            Style="{StaticResource ButtonDefault}" Click="OnNextClick" />
                    <Button x:Name="BtnSave" Content="保存修改"
                            Style="{StaticResource ButtonPrimary}" Click="OnSaveClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 表单内容 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel x:Name="FormPanel" HorizontalAlignment="Stretch" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
