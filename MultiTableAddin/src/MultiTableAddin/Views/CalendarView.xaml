<UserControl x:Class="MultiTableAddin.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:controls="clr-namespace:MultiTableAddin.Views.Controls"
             Background="{DynamicResource BackgroundBrush}">
    <DockPanel>
        <!-- 视图与月份导航 -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- 视图切换 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BtnDayView" Content="日" Width="40" Margin="0,0,4,0"
                            Style="{StaticResource ButtonDefault}" Click="OnDayViewClick" />
                    <Button x:Name="BtnWeekView" Content="周" Width="40" Margin="0,0,4,0"
                            Style="{StaticResource ButtonDefault}" Click="OnWeekViewClick" />
                    <Button x:Name="BtnMonthView" Content="月" Width="40"
                            Style="{StaticResource ButtonDefault}" Click="OnMonthViewClick" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="BtnPrev" Content="‹ 前一月" Margin="0,0,8,0"
                            Style="{StaticResource ButtonDefault}" Click="OnPrevClick" />
                    <controls:MultiTableDatePicker x:Name="DatePicker" Width="130" Margin="0,0,8,0"
                                SelectedDateChanged="OnDatePickerChanged" />
                    <Button x:Name="BtnToday" Content="今天" Margin="0,0,8,0"
                            Style="{StaticResource ButtonDefault}" Click="OnTodayClick" />
                    <Button x:Name="BtnNext" Content="后一月 ›"
                            Style="{StaticResource ButtonDefault}" Click="OnNextClick" />
                </StackPanel>

                <TextBlock x:Name="MonthLabel" Text="" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
            </DockPanel>
        </Border>

        <!-- 日历网格 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="CalendarGrid" Margin="8" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
