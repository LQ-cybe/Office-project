<UserControl x:Class="MultiTableAddin.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:controls="clr-namespace:MultiTableAddin.Views.Controls"
             Background="{DynamicResource BackgroundBrush}"
             Loaded="DashboardView_Loaded">
    <UserControl.Resources>
        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="ToolCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- 筛选工具条 -->
        <Border DockPanel.Dock="Top" Padding="12,8"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="BtnAddStat" Content="添加指标" FontSize="12" Margin="0,0,8,0"
                            Style="{StaticResource ButtonDefault}"
                            hc:BorderElement.CornerRadius="4" Click="OnAddStatClick" />
                    <Button x:Name="BtnAddChart" Content="添加图表" FontSize="12" Margin="0,0,8,0"
                            Style="{StaticResource ButtonPrimary}"
                            hc:BorderElement.CornerRadius="4" Click="OnAddChartClick" />
                    <Button x:Name="BtnResetFilter" Content="重置" FontSize="12"
                            Style="{StaticResource ButtonDefault}"
                            hc:BorderElement.CornerRadius="4" Click="OnResetFilterClick" />
                </StackPanel>

                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="时间字段" Style="{StaticResource ToolLabel}" />
                    <ComboBox x:Name="TimeFieldCombo" Style="{StaticResource ToolCombo}"
                              SelectionChanged="OnFilterChanged" />

                    <TextBlock Text="时间粒度" Style="{StaticResource ToolLabel}" />
                    <ComboBox x:Name="TimeGroupCombo" Style="{StaticResource ToolCombo}"
                              SelectionChanged="OnFilterChanged" />

                    <TextBlock Text="起止" Style="{StaticResource ToolLabel}" />
                    <controls:MultiTableDatePicker x:Name="StartPicker" FontSize="12" Width="118" Margin="0,0,4,0"
                                VerticalAlignment="Center" SelectedDateChanged="OnFilterChanged" />
                    <TextBlock Text="~" Style="{StaticResource ToolLabel}" />
                    <controls:MultiTableDatePicker x:Name="EndPicker" FontSize="12" Width="118" Margin="0,0,12,0"
                                VerticalAlignment="Center" SelectedDateChanged="OnFilterChanged" />

                    <TextBlock Text="搜索" Style="{StaticResource ToolLabel}" />
                    <TextBox x:Name="SearchBox" FontSize="12" Width="150" Margin="0,0,12,0"
                             VerticalAlignment="Center"
                             hc:InfoElement.Placeholder="全字段关键字"
                             TextChanged="OnSearchChanged" />

                    <TextBlock x:Name="RowSummary" Text="" Style="{StaticResource ToolLabel}"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 仪表盘主体 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,12,12,20">
                <WrapPanel x:Name="StatPanel" Orientation="Horizontal" Margin="0,0,0,4" />
                <Grid x:Name="ChartGrid" Margin="0,8,0,0" />
                <TextBlock x:Name="EmptyHint" Text="" FontSize="13" Margin="4,24,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ThirdlyTextBrush}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
