<UserControl x:Class="MultiTableAddin.Views.MultiTableMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:views="clr-namespace:MultiTableAddin.Views"
             Background="{DynamicResource RegionBrush}"
             Loaded="MultiTableMainView_Loaded"
             Unloaded="MultiTableMainView_Unloaded">
    <UserControl.Resources>
        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="hc:BorderElement.CornerRadius" Value="4" />
        </Style>
        <Style x:Key="SidebarButtonActive" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="hc:BorderElement.CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource SecondaryRegionBrush}">
            <DockPanel>
                <!-- 顶部标题 -->
                <Border DockPanel.Dock="Top" Padding="12,16,12,12">
                    <StackPanel>
                        <TextBlock Text="多维表分析" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock x:Name="SourceInfoText" Text="未加载数据" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="VersionText" Text="" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Padding="6,0,6,6">
                    <Button x:Name="BtnLoadData" Style="{StaticResource ButtonPrimary}"
                            HorizontalAlignment="Stretch"
                            hc:BorderElement.CornerRadius="4"
                            Content="加载数据" Click="OnLoadDataClick" />
                </Border>

                <Border DockPanel.Dock="Top" Padding="6,2,6,2">
                    <Button x:Name="BtnFieldConfig" Style="{StaticResource ButtonDefault}"
                            HorizontalAlignment="Stretch"
                            hc:BorderElement.CornerRadius="4"
                            hc:IconElement.Geometry="{StaticResource SettingGeometry}"
                            Content="字段配置" Click="OnFieldConfigClick"
                            Visibility="Collapsed" />
                </Border>

                <!-- 视图列表 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                    <StackPanel x:Name="ViewListPanel" Margin="2,0" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 分隔线 -->
        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}" />

        <!-- 主内容区 -->
        <DockPanel Grid.Column="2">
            <!-- 顶部工具栏 -->
            <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- 视图名称 -->
                    <TextBlock x:Name="CurrentViewName" Text="请加载数据" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <!-- 右侧操作按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button x:Name="BtnAddView" Style="{StaticResource ButtonDefault}"
                                Content="新建视图" Margin="0,0,8,0" Click="OnAddViewClick"
                                hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                Visibility="Collapsed" />
                        <Button x:Name="BtnRefresh" Style="{StaticResource ButtonDefault}"
                                Content="刷新" Margin="0,0,8,0" Click="OnRefreshClick"
                                Visibility="Collapsed" />
                        <Button x:Name="BtnSave" Style="{StaticResource ButtonPrimary}"
                                Content="保存" Click="OnSaveClick"
                                Visibility="Collapsed" />
                    </StackPanel>

                    <!-- 中间筛选信息 -->
                    <TextBlock x:Name="FilterInfo" Text="" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                </DockPanel>
            </Border>

            <!-- 视图内容区域 -->
            <Grid x:Name="ViewContentArea" Background="{DynamicResource BackgroundBrush}" />
        </DockPanel>
    </Grid>
</UserControl>
