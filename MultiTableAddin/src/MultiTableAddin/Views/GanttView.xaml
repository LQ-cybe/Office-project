<UserControl x:Class="MultiTableAddin.Views.GanttView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource BackgroundBrush}">
    <DockPanel>
        <!-- 顶部工具栏：左侧字段设置，右侧 日/周/月/季/年 切换 -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="BtnConfig" Content="字段设置"
                            Style="{StaticResource ButtonDefault}" hc:BorderElement.CornerRadius="4"
                            Click="OnConfigClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"
                            x:Name="DimButtonPanel">
                    <Button x:Name="BtnDimDay" Content="日" Tag="Day" Margin="0,0,6,0"
                            Style="{StaticResource ButtonDefault}" hc:BorderElement.CornerRadius="4"
                            Click="OnDimButtonClick" />
                    <Button x:Name="BtnDimWeek" Content="周" Tag="Week" Margin="0,0,6,0"
                            Style="{StaticResource ButtonDefault}" hc:BorderElement.CornerRadius="4"
                            Click="OnDimButtonClick" />
                    <Button x:Name="BtnDimMonth" Content="月" Tag="Month" Margin="0,0,6,0"
                            Style="{StaticResource ButtonDefault}" hc:BorderElement.CornerRadius="4"
                            Click="OnDimButtonClick" />
                    <Button x:Name="BtnDimQuarter" Content="季" Tag="Quarter" Margin="0,0,6,0"
                            Style="{StaticResource ButtonDefault}" hc:BorderElement.CornerRadius="4"
                            Click="OnDimButtonClick" />
                    <Button x:Name="BtnDimYear" Content="年" Tag="Year"
                            Style="{StaticResource ButtonDefault}" hc:BorderElement.CornerRadius="4"
                            Click="OnDimButtonClick" />
                </StackPanel>

                <TextBlock x:Name="GanttInfo" Text="" FontSize="12" VerticalAlignment="Center"
                           Margin="12,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
            </DockPanel>
        </Border>

        <!-- 主体：左侧分组列表（按最宽内容自适应）+ 右侧时间轴（顶部日期冻结） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧任务/分组列表 -->
            <Border Grid.Column="0" Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer x:Name="LeftScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto" MaxWidth="320">
                    <StackPanel x:Name="TaskTreePanel" />
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" />

            <!-- 右侧时间轴：第 0 行冻结日期表头，第 1 行可滚动 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 冻结的日期表头 -->
                <Canvas x:Name="HeaderCanvas" Grid.Row="0"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        ClipToBounds="True" />

                <!-- 可滚动的时间轴主体 -->
                <ScrollViewer x:Name="RightScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Canvas x:Name="TimelineCanvas" Background="{DynamicResource RegionBrush}" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
