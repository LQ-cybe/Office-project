<Window x:Class="MultiTableAddin.Views.GalleryDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:controls="clr-namespace:MultiTableAddin.Views.Controls"
        Title="记录详情" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource RegionBrush}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                   HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnLocate" Content="定位到表格" Width="96" Margin="0,0,10,0"
                    Style="{StaticResource ButtonDefault}" hc:BorderElement.CornerRadius="4"
                    Click="OnLocateClick" />
            <Button Content="确定" Width="88" Margin="0,0,10,0"
                    Style="{StaticResource ButtonPrimary}" hc:BorderElement.CornerRadius="4"
                    Click="OnOkClick" />
            <Button Content="取消" Width="88"
                    Style="{StaticResource ButtonDefault}" hc:BorderElement.CornerRadius="4"
                    Click="OnCancelClick" />
        </StackPanel>

        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" MaxHeight="560">
            <controls:RecordEditor x:Name="Editor" MinLabelWidth="84" MaxLabelWidth="200" />
        </ScrollViewer>
    </DockPanel>
</Window>
